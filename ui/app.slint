// LGroot — a small native wizard for rooting LG webOS TVs.
// Copyright 2026. Licensed under AGPL-3.0-or-later. No warranties.
//
// Layout: a stage rail on the left (Find, Allow, Install, Finish) and one
// workspace on the right with a pinned action bar. Colours, sizes and copy
// follow the LGroot design system; every value lives in `Theme`.

import { ScrollView, LineEdit, Palette } from "std-widgets.slint";

export struct TvItem {
    ip: string,
    name: string,
    detail: string,
    badge: string,
}

// ---------------------------------------------------------------------------
// Tokens
// ---------------------------------------------------------------------------

export global Theme {
    out property <bool> dark: Palette.color-scheme != ColorScheme.light;
    // Set from Rust per platform; generic family names do not resolve everywhere.
    in-out property <string> mono: "monospace";

    out property <color> bg: dark ? #121418 : #f5f6f8;
    out property <color> surface: dark ? #181b20 : #ffffff;
    out property <color> surface-raised: dark ? #20242a : #eef0f3;
    out property <color> surface-hover: dark ? #272c33 : #e5e8ec;
    out property <color> border: dark ? #2b3038 : #dcdfe4;
    out property <color> border-control: dark ? #646b76 : #848b95;
    out property <color> text: dark ? #e9ebee : #15181c;
    out property <color> text-muted: dark ? #a0a7b1 : #4f5661;
    out property <color> text-subtle: dark ? #7c838e : #646b76;
    out property <color> accent: dark ? #3ea6ff : #1769c2;
    out property <color> accent-hover: dark ? #3999eb : #1561b3;
    out property <color> on-accent: dark ? #071421 : #ffffff;
    out property <color> accent-subtle: dark ? #16283b : #e4eefa;
    out property <color> accent-text: dark ? #8cc4ff : #14589f;
    out property <color> success: dark ? #4cc777 : #1b7a43;
    out property <color> success-subtle: dark ? #132a1c : #e3f2e9;
    out property <color> warning: dark ? #e0aa4a : #8c5d0a;
    out property <color> warning-subtle: dark ? #2a2212 : #f8efdb;
    out property <color> danger: dark ? #f07474 : #bd3232;
    out property <color> danger-subtle: dark ? #2e1819 : #f9e4e4;
    out property <color> scrim: dark ? #050608b8 : #15181c5c;

    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 8px;
    out property <length> control-height: 32px;
    out property <length> rail-width: 200px;

    out property <duration> fast: 120ms;
}

// ---------------------------------------------------------------------------
// Controls
// ---------------------------------------------------------------------------

component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    min-width: txt.preferred-width + 32px;
    max-width: txt.preferred-width + 32px;
    height: Theme.control-height;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: root.primary ? Theme.accent : Theme.border;
    background: root.primary
        ? (touch.has-hover && root.enabled ? Theme.accent-hover : Theme.accent)
        : (touch.has-hover && root.enabled ? Theme.surface-hover : Theme.surface-raised);
    opacity: root.enabled ? 1.0 : 0.45;

    txt := Text {
        text: root.label;
        color: root.primary ? Theme.on-accent : Theme.text;
        font-size: 13px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    animate background { duration: Theme.fast; easing: ease-out; }
    animate opacity { duration: Theme.fast; easing: ease-out; }
}

component LinkBtn inherits Text {
    in property <string> label;
    callback clicked();

    text: root.label;
    color: touch.has-hover ? Theme.text : Theme.text-muted;
    font-size: 13px;
    font-weight: 500;
    vertical-alignment: center;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Field inherits LineEdit {
    min-height: Theme.control-height;
    max-height: Theme.control-height;
    font-size: 12px;
}

component Bar inherits Rectangle {
    in property <float> value: 0.0;

    height: 4px;
    border-radius: 2px;
    background: Theme.surface-hover;

    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0.0, 1.0);
        height: parent.height;
        border-radius: 2px;
        background: Theme.accent;
        animate width { duration: 180ms; }
    }
}

component Panel inherits Rectangle {
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-lg;
}

component SectionLabel inherits Text {
    color: Theme.text-muted;
    font-size: 12px;
    font-weight: 500;
}

component Hint inherits Text {
    color: Theme.text-subtle;
    font-size: 12px;
    wrap: word-wrap;
}

component PageHead inherits VerticalLayout {
    in property <string> title;
    in property <string> lede;

    spacing: 4px;

    Text {
        text: root.title;
        color: Theme.text;
        font-size: 22px;
        font-weight: 600;
        wrap: word-wrap;
    }
    Text {
        text: root.lede;
        color: Theme.text-muted;
        font-size: 13px;
        wrap: word-wrap;
    }
}

// ---------------------------------------------------------------------------
// Marks, drawn as paths so they never depend on a font's glyphs
// ---------------------------------------------------------------------------

// kind: 0 pending, 1 active, 2 done, 3 failed
component Marker inherits Rectangle {
    in property <int> kind: 0;

    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: root.kind == 2 ? Theme.success : (root.kind == 3 ? Theme.danger : transparent);
    border-width: root.kind == 0 ? 1px : (root.kind == 1 ? 1.5px : 0px);
    border-color: root.kind == 1 ? Theme.accent : Theme.border-control;

    if root.kind == 1 : Rectangle {
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.accent;
    }

    if root.kind == 2 : Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 4.8 8.3 L 6.9 10.4 L 11.2 5.8";
        stroke: Theme.bg;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        fill: transparent;
    }

    if root.kind == 3 : Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 5.5 5.5 L 10.5 10.5 M 10.5 5.5 L 5.5 10.5";
        stroke: Theme.bg;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        fill: transparent;
    }
}

component ResultMark inherits Rectangle {
    in property <bool> ok: true;

    width: 48px;
    height: 48px;
    border-radius: 24px;
    background: root.ok ? Theme.success-subtle : Theme.danger-subtle;

    Path {
        width: 48px;
        height: 48px;
        viewbox-width: 56;
        viewbox-height: 56;
        commands: root.ok ? "M 18.5 28.5 L 25 35 L 37.5 21.5" : "M 21 21 L 35 35 M 35 21 L 21 35";
        stroke: root.ok ? Theme.success : Theme.danger;
        stroke-width: 2px;
        stroke-line-cap: round;
        fill: transparent;
    }
}

component Chevron inherits Path {
    in property <bool> down: false;

    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    commands: root.down ? "M 2.5 4.5 L 6 8 L 9.5 4.5" : "M 4.5 2.5 L 8 6 L 4.5 9.5";
    stroke: Theme.text-subtle;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    fill: transparent;
}

// ---------------------------------------------------------------------------
// Lists
// ---------------------------------------------------------------------------

component DeviceRow inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <string> badge;
    callback picked();

    height: 56px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface-raised;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 12px;
        alignment: stretch;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.name;
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.detail;
                color: Theme.text-muted;
                font-size: 12px;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 20px;
                min-width: tag.preferred-width + 16px;
                border-radius: Theme.radius-sm;
                background: Theme.accent-subtle;
                tag := Text {
                    text: root.badge;
                    color: Theme.accent-text;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Chevron { width: 16px; height: 16px; }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked();
        }
    }

    animate background { duration: Theme.fast; easing: ease-out; }
}

component NumberItem inherits HorizontalLayout {
    in property <int> n;
    in property <string> text;

    spacing: 12px;

    VerticalLayout {
        alignment: start;
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border-control;
            Text {
                text: root.n;
                color: Theme.text-muted;
                font-size: 11px;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    Text {
        horizontal-stretch: 1;
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        wrap: word-wrap;
        vertical-alignment: center;
    }
}

component StepItem inherits HorizontalLayout {
    in property <string> label;
    in property <string> detail;
    in property <int> kind;

    spacing: 10px;
    height: 20px;

    VerticalLayout {
        alignment: center;
        Marker { kind: root.kind; }
    }
    Text {
        horizontal-stretch: 1;
        text: root.label;
        color: root.kind == 0 ? Theme.text-subtle : Theme.text;
        font-size: 13px;
        vertical-alignment: center;
    }
    Text {
        text: root.detail;
        color: Theme.text-subtle;
        font-size: 12px;
        vertical-alignment: center;
    }
}

component StageItem inherits Rectangle {
    in property <string> label;
    in property <int> kind;

    height: 32px;
    border-radius: Theme.radius-md;
    background: root.kind == 1 || root.kind == 3 ? Theme.surface-raised : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Marker { kind: root.kind; }
        }
        Text {
            text: root.label;
            color: root.kind == 0 ? Theme.text-subtle : (root.kind == 2 ? Theme.text-muted : Theme.text);
            font-size: 13px;
            font-weight: root.kind == 1 || root.kind == 3 ? 500 : 400;
            vertical-alignment: center;
        }
    }
}

// The technical log: a disclosure row that opens to selectable text.
component LogPanel inherits Panel {
    in-out property <bool> open: false;
    in property <string> log-text;
    in property <bool> can-copy: false;

    VerticalLayout {
        Rectangle {
            height: 40px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Chevron { down: root.open; }
                }
                Text {
                    horizontal-stretch: 1;
                    text: "Technical log";
                    color: Theme.text-muted;
                    font-size: 12px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.open = !root.open;
                }
            }
            HorizontalLayout {
                padding-right: 16px;
                alignment: end;
                LinkBtn {
                    visible: root.can-copy && root.open;
                    label: "Copy log";
                    clicked => {
                        log-view.select-all();
                        log-view.copy();
                        log-view.clear-selection();
                    }
                }
            }
        }

        Rectangle {
            visible: root.open;
            vertical-stretch: root.open ? 1 : 0;
            min-height: 0px;
            max-height: root.open ? 10000px : 0px;

            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border;
            }

            ScrollView {
                y: 1px;
                height: parent.height - 1px;
                content-height: max(self.visible-height, log-view.preferred-height + 20px);

                log-view := TextInput {
                    x: 16px;
                    y: 10px;
                    width: parent.width - 32px;
                    text: root.log-text;
                    read-only: true;
                    single-line: false;
                    wrap: word-wrap;
                    color: Theme.text-subtle;
                    font-size: 11px;
                    font-family: Theme.mono;
                    selection-background-color: Theme.accent-subtle;
                    selection-foreground-color: Theme.text;
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Shell
// ---------------------------------------------------------------------------

component Rail inherits Rectangle {
    // kind of each stage, see Marker
    in property <[int]> stages;
    callback settings();

    width: Theme.rail-width;
    background: Theme.surface;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        padding-top: 20px;
        padding-bottom: 16px;
        padding-left: 12px;
        padding-right: 13px;

        VerticalLayout {
            padding-left: 8px;
            padding-bottom: 24px;
            spacing: 2px;
            Text {
                text: "LGroot";
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
            }
            Text {
                text: "Homebrew Channel installer";
                color: Theme.text-subtle;
                font-size: 11px;
            }
        }

        VerticalLayout {
            spacing: 2px;
            StageItem { label: "Find your TV"; kind: root.stages[0]; }
            StageItem { label: "Allow on TV"; kind: root.stages[1]; }
            StageItem { label: "Install"; kind: root.stages[2]; }
            StageItem { label: "Finish"; kind: root.stages[3]; }
        }

        Rectangle { vertical-stretch: 1; }

        VerticalLayout {
            padding-left: 8px;
            spacing: 12px;
            LinkBtn {
                label: "Network settings";
                clicked => {
                    root.settings();
                }
            }
            VerticalLayout {
                Text { text: "AGPL-3.0 licence"; color: Theme.text-subtle; font-size: 11px; }
                Text { text: "Payload by throwaway96"; color: Theme.text-subtle; font-size: 11px; }
            }
        }
    }
}

component ActionBar inherits Rectangle {
    height: 57px;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 13px;
        padding-bottom: 12px;
        spacing: 8px;
        @children
    }
}

component Spacer inherits Rectangle {
    horizontal-stretch: 1;
}

component Sheet inherits Rectangle {
    in property <string> title;
    in property <string> lede;

    background: Theme.scrim;

    // swallow clicks so the window behind stays inert
    TouchArea { }

    card := Rectangle {
        width: 440px;
        height: inner.preferred-height;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: Theme.radius-lg;

        inner := VerticalLayout {
            padding-top: 20px;
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 0px;
            spacing: 16px;

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 600;
                }
                Hint { text: root.lede; }
            }

            @children
        }
    }
}

component SheetFooter inherits VerticalLayout {
    padding-left: -20px;
    padding-right: -20px;

    Rectangle {
        height: 57px;
        Rectangle {
            y: 0;
            height: 1px;
            background: Theme.border;
        }
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 13px;
            padding-bottom: 12px;
            spacing: 8px;
            alignment: end;
            @children
        }
    }
}

// ---------------------------------------------------------------------------
// Main window
// ---------------------------------------------------------------------------

export component AppWindow inherits Window {
    title: "LGroot";
    preferred-width: 760px;
    preferred-height: 620px;
    min-width: 760px;
    min-height: 620px;
    background: Theme.bg;
    default-font-size: 13px;

    // With no system preference the window is dark; keep the stock text
    // fields in step with it.
    init => {
        if (Palette.color-scheme == ColorScheme.unknown) {
            Palette.color-scheme = ColorScheme.dark;
        }
    }

    // pages: 0 = find, 1 = allow on TV, 2 = install, 3 = done, 4 = error
    in-out property <int> page: 0;

    // discovery
    in-out property <bool> scanning: false;
    in-out property <bool> scanning-done: false;
    in-out property <float> scan-progress: 0.0;
    in-out property <string> scan-text: "";
    in-out property <int> scan-total: 0;
    in-out property <[TvItem]> tvs;

    // pairing
    in-out property <string> target-name: "";
    in-out property <string> target-ip: "";
    in-out property <string> pair-countdown: "1:00";
    in-out property <float> pair-progress: 1.0;

    // installing; step counts completed steps (0..=4)
    in-out property <int> step: 0;
    in-out property <string> files-text: "";
    in-out property <float> files-progress: 0.0;
    in-out property <string> log-text: "";

    // done / error
    in-out property <string> result-title: "";
    in-out property <string> result-body: "";
    in-out property <string> result-hint: "";

    // settings and manual address
    in-out property <string> local-ip: "";
    in-out property <string> detected-ip: "";
    in-out property <string> manual-ip: "";
    in-out property <string> manual-error: "";
    in-out property <bool> debug-payload: false;
    in-out property <string> test-url: "";
    in-out property <bool> settings-open: false;
    in-out property <bool> connect-open: false;

    callback scan-requested();
    callback tv-picked(string);
    callback cancel-requested();
    callback restart-requested();
    callback probe-requested(string);
    callback test-requested();
    callback reboot-requested();
    callback launch-hb-requested();

    property <string> settings-draft;
    property <bool> no-tvs: root.page == 0 && root.scanning-done && !root.scanning && root.tvs.length == 0;
    property <string> tv-label: root.target-name != "" ? root.target-name : "your TV";

    // Rail state. A failure before pairing finished belongs to "Allow on TV",
    // after it to "Install".
    property <int> failed-stage: root.step < 2 ? 1 : 2;
    property <int> current-stage: root.page == 3 ? 4 : root.page;
    pure function stage-kind(i: int) -> int {
        if (root.page == 4) {
            return i < root.failed-stage ? 2 : (i == root.failed-stage ? 3 : 0);
        }
        return i < root.current-stage ? 2 : (i == root.current-stage ? 1 : 0);
    }
    pure function step-kind(i: int) -> int {
        return root.step > i ? 2 : (root.step == i ? 1 : 0);
    }

    HorizontalLayout {
        Rail {
            stages: [root.stage-kind(0), root.stage-kind(1), root.stage-kind(2), root.stage-kind(3)];
            settings => {
                root.settings-draft = root.local-ip;
                root.settings-open = true;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;

            // =================================================================
            // Find your TV
            // =================================================================
            if root.page == 0 && !root.no-tvs : VerticalLayout {
                vertical-stretch: 1;
                padding: 32px;
                padding-top: 28px;
                padding-bottom: 20px;
                spacing: 16px;

                PageHead {
                    title: "Choose your TV";
                    lede: "Make sure the TV is on and connected to the same network as this computer. Nothing changes on the TV until you allow it.";
                }

                Panel {
                    vertical-stretch: 1;
                    min-height: 0px;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 8px;

                        VerticalLayout {
                            vertical-stretch: 0;
                            padding: 6px;
                            padding-bottom: 2px;
                            spacing: 8px;
                            HorizontalLayout {
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.scanning ? "Searching your network…" : "Search finished";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                }
                                Text {
                                    text: root.scan-text;
                                    color: Theme.text-subtle;
                                    font-size: 12px;
                                }
                            }
                            if root.scanning : Bar { value: root.scan-progress; }
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            min-height: 0px;

                            VerticalLayout {
                                spacing: 8px;
                                alignment: start;

                                for tv in root.tvs : DeviceRow {
                                    name: tv.name;
                                    detail: tv.detail;
                                    badge: tv.badge;
                                    picked => {
                                        root.tv-picked(tv.ip);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.page == 0 && !root.no-tvs : ActionBar {
                LinkBtn {
                    label: "Enter an IP address";
                    clicked => {
                        root.manual-error = "";
                        root.connect-open = true;
                    }
                }
                Spacer { }
                Btn {
                    label: "Scan again";
                    enabled: !root.scanning;
                    clicked => {
                        root.scan-requested();
                    }
                }
            }

            // =================================================================
            // Find your TV — nothing answered
            // =================================================================
            if root.no-tvs : VerticalLayout {
                vertical-stretch: 1;
                padding: 32px;
                padding-top: 28px;
                padding-bottom: 20px;
                spacing: 16px;
                alignment: start;

                PageHead {
                    title: "No TVs found";
                    lede: "LGroot checked " + root.scan-total + " addresses on your network and no LG TV answered.";
                }

                Panel {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        SectionLabel { text: "Check these, then scan again"; }
                        NumberItem { n: 1; text: "The TV is switched on, not in standby."; }
                        NumberItem { n: 2; text: "The TV and this computer are on the same Wi-Fi or wired network."; }
                    }
                }

                Panel {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        SectionLabel { text: "Or connect by address"; }
                        HorizontalLayout {
                            spacing: 8px;
                            Field {
                                horizontal-stretch: 1;
                                text <=> root.manual-ip;
                                placeholder-text: "TV IP address, e.g. 192.168.1.50";
                                accepted => {
                                    root.probe-requested(root.manual-ip);
                                }
                            }
                            Btn {
                                label: "Connect";
                                enabled: root.manual-ip != "";
                                clicked => {
                                    root.probe-requested(root.manual-ip);
                                }
                            }
                        }
                        if root.manual-error != "" : Text {
                            text: root.manual-error;
                            color: Theme.danger;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        Hint { text: "On the TV: Settings, Network, Wi-Fi Connection, Advanced Settings."; }
                    }
                }
            }

            if root.no-tvs : ActionBar {
                Spacer { }
                Btn {
                    label: "Scan again";
                    primary: true;
                    clicked => {
                        root.scan-requested();
                    }
                }
            }

            // =================================================================
            // Allow on TV
            // =================================================================
            if root.page == 1 : VerticalLayout {
                vertical-stretch: 1;
                padding: 32px;
                padding-top: 28px;
                padding-bottom: 20px;
                spacing: 16px;
                alignment: start;

                PageHead {
                    title: "Allow LGroot on your TV";
                    lede: "Your TV is showing a request from “SlopBro”. Accept it with the remote.";
                }

                Panel {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        NumberItem { n: 1; text: "Look for a message on the TV asking to allow “SlopBro”. It can appear in a corner of the screen."; }
                        NumberItem { n: 2; text: "Select Yes, or press OK on the remote."; }
                        NumberItem { n: 3; text: "Come back here. LGroot continues on its own."; }
                    }
                }

                Panel {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        HorizontalLayout {
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: end;
                                spacing: 2px;
                                Text {
                                    text: "Waiting for your answer";
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 500;
                                }
                                Text {
                                    text: root.target-name != "" ? root.target-name + " · " + root.target-ip : root.target-ip;
                                    color: Theme.text-subtle;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                            Text {
                                text: root.pair-countdown;
                                color: Theme.text;
                                font-size: 40px;
                                font-weight: 600;
                                vertical-alignment: bottom;
                            }
                        }
                        Bar { value: root.pair-progress; }
                    }
                }
            }

            if root.page == 1 : ActionBar {
                Spacer { }
                Btn {
                    label: "Cancel";
                    clicked => {
                        root.cancel-requested();
                    }
                }
            }

            // =================================================================
            // Install
            // =================================================================
            if root.page == 2 : VerticalLayout {
                vertical-stretch: 1;
                padding: 32px;
                padding-top: 28px;
                padding-bottom: 20px;
                spacing: 16px;

                PageHead {
                    title: "Installing Homebrew Channel";
                    lede: "This takes about a minute. Keep this window open and leave the remote alone.";
                }

                Panel {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        StepItem { label: "Connected to " + root.tv-label; detail: root.target-ip; kind: root.step-kind(0); }
                        StepItem { label: "Permission granted"; kind: root.step-kind(1); }
                        StepItem { label: "Sending the installer"; detail: root.step == 2 ? root.files-text : ""; kind: root.step-kind(2); }
                        StepItem { label: "Verifying Homebrew Channel"; kind: root.step-kind(3); }
                        if root.step == 2 : HorizontalLayout {
                            padding-left: 26px;
                            padding-top: 4px;
                            Bar { horizontal-stretch: 1; value: root.files-progress; }
                        }
                    }
                }

                install-log := LogPanel {
                    vertical-stretch: self.open ? 1 : 0;
                    log-text: root.log-text;
                }

                if !install-log.open : Rectangle { vertical-stretch: 1; }
            }

            if root.page == 2 : ActionBar {
                Text {
                    text: "The TV shows its own progress too.";
                    color: Theme.text-subtle;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Spacer { }
            }

            // =================================================================
            // Finish — success
            // =================================================================
            if root.page == 3 : VerticalLayout {
                vertical-stretch: 1;
                padding: 32px;
                padding-top: 28px;
                padding-bottom: 20px;
                spacing: 16px;
                alignment: start;

                HorizontalLayout {
                    alignment: start;
                    ResultMark { ok: true; }
                }

                PageHead {
                    title: "Homebrew Channel is installed";
                    lede: (root.target-name != "" ? root.target-name : "Your TV") + " is rooted. Restart it to finish.";
                }

                Panel {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        SectionLabel { text: "What happens next"; }
                        NumberItem { n: 1; text: "Restart the TV. LGroot can do it for you."; }
                        NumberItem { n: 2; text: "Open Homebrew Channel from the TV's app list."; }
                        NumberItem { n: 3; text: "Install apps from its catalogue."; }
                    }
                }

                Rectangle {
                    background: Theme.warning-subtle;
                    border-width: 1px;
                    border-color: Theme.warning;
                    border-radius: Theme.radius-sm;

                    HorizontalLayout {
                        padding: 12px;
                        spacing: 4px;
                        Text {
                            text: "Important:";
                            color: Theme.warning;
                            font-size: 13px;
                            font-weight: 600;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "do not install LG's Developer Mode app on this TV. If it is installed, remove it before restarting.";
                            color: Theme.text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if root.page == 3 : ActionBar {
                LinkBtn {
                    label: "Root another TV";
                    clicked => {
                        root.restart-requested();
                    }
                }
                Spacer { }
                Btn {
                    label: "Open Homebrew Channel";
                    clicked => {
                        root.launch-hb-requested();
                    }
                }
                Btn {
                    label: "Restart TV";
                    primary: true;
                    clicked => {
                        root.reboot-requested();
                    }
                }
            }

            // =================================================================
            // Error
            // =================================================================
            if root.page == 4 : VerticalLayout {
                vertical-stretch: 1;
                padding: 32px;
                padding-top: 28px;
                padding-bottom: 20px;
                spacing: 16px;

                HorizontalLayout {
                    alignment: start;
                    ResultMark { ok: false; }
                }

                PageHead {
                    title: root.result-title;
                    lede: root.result-body;
                }

                if root.result-hint != "" : Panel {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        SectionLabel { text: "What to try"; }
                        Text {
                            text: root.result-hint;
                            color: Theme.text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }

                LogPanel {
                    vertical-stretch: 1;
                    open: true;
                    can-copy: true;
                    log-text: root.log-text;
                }
            }

            if root.page == 4 : ActionBar {
                LinkBtn {
                    label: "Back to TV list";
                    clicked => {
                        root.restart-requested();
                    }
                }
                Spacer { }
                Btn {
                    label: "Try again";
                    primary: true;
                    clicked => {
                        if (root.target-ip != "") {
                            root.tv-picked(root.target-ip);
                        } else {
                            root.restart-requested();
                        }
                    }
                }
            }
        }
    }

    // =========================================================================
    // Sheets
    // =========================================================================

    if root.settings-open : Sheet {
        width: root.width;
        height: root.height;
        title: "Network settings";
        lede: "Only change these if the TV cannot download the installer.";

        VerticalLayout {
            spacing: 6px;
            Text { text: "This computer's address"; color: Theme.text-muted; font-size: 12px; }
            Field {
                text <=> root.settings-draft;
                placeholder-text: root.detected-ip != "" ? "Automatic (" + root.detected-ip + ")" : "Automatic";
            }
            Hint { text: "The TV downloads the installer from this address."; }
        }

        VerticalLayout {
            spacing: 8px;
            Text { text: "Connection test"; color: Theme.text-muted; font-size: 12px; }
            HorizontalLayout {
                alignment: start;
                Btn {
                    label: "Test connection";
                    clicked => {
                        root.test-requested();
                    }
                }
            }
            if root.test-url != "" : VerticalLayout {
                spacing: 4px;
                Hint { text: "Open this address in the TV's web browser. It should show a short confirmation page."; }
                TextInput {
                    text: root.test-url;
                    read-only: true;
                    color: Theme.text;
                    font-size: 11px;
                    font-family: Theme.mono;
                    selection-background-color: Theme.accent-subtle;
                }
            }
        }

        SheetFooter {
            Btn {
                label: "Cancel";
                clicked => {
                    root.settings-open = false;
                }
            }
            Btn {
                label: "Save";
                primary: true;
                clicked => {
                    root.local-ip = root.settings-draft;
                    root.settings-open = false;
                }
            }
        }
    }

    if root.connect-open : Sheet {
        width: root.width;
        height: root.height;
        title: "Connect by address";
        lede: "Use this if your TV is on but does not show up in the list.";

        VerticalLayout {
            spacing: 6px;
            Text { text: "TV IP address"; color: Theme.text-muted; font-size: 12px; }
            Field {
                text <=> root.manual-ip;
                placeholder-text: "e.g. 192.168.1.50";
                accepted => {
                    root.probe-requested(root.manual-ip);
                }
            }
            if root.manual-error != "" : Text {
                text: root.manual-error;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
            }
            Hint { text: "On the TV: Settings, Network, Wi-Fi Connection, Advanced Settings."; }
        }

        SheetFooter {
            Btn {
                label: "Cancel";
                clicked => {
                    root.connect-open = false;
                }
            }
            Btn {
                label: "Connect";
                primary: true;
                enabled: root.manual-ip != "";
                clicked => {
                    root.probe-requested(root.manual-ip);
                }
            }
        }
    }
}
